{
  "name": "codenzia/browser-console",
  "description": "A web-based Artisan console, shell terminal, log viewer, and debug tool for Laravel — accessible from your browser, no database required.",
  "keywords": [
    "codenzia",
    "laravel",
    "artisan",
    "console",
    "terminal",
    "shell",
    "debug",
    "logs",
    "browser-console"
  ],
  "homepage": "https://github.com/codenzia/browser-console",
  "support": {
    "issues": "https://github.com/codenzia/browser-console/issues",
    "source": "https://github.com/codenzia/browser-console"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Codenzia",
      "email": "support@codenzia.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "livewire/livewire": "^3.0 || ^4.0",
    "spatie/laravel-package-tools": "^1.17.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "nunomaduro/collision": "^8.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Codenzia\\BrowserConsole\\": "src/"
    },
    "files": [
      "src/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Codenzia\\BrowserConsole\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.5.x-dev"
    },
    "laravel": {
      "providers": [
        "Codenzia\\BrowserConsole\\BrowserConsoleServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
